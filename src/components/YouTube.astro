---
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;
---

<div class="my-8 aspect-video rounded-xl overflow-hidden shadow-lg border border-gray-200 dark:border-gray-700">
  <iframe
    class="w-full h-full"
    src={`https://www.youtube.com/embed/${videoId}`}
    title="YouTube video player"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
