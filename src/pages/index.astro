---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles')).filter(
  (article) => !article.data.draft
);

const allSnippets = (await getCollection('snippets')).filter(
  (snippet) => !snippet.data.draft
);

// Sort by date (newest first)
const sortedArticles = allArticles.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const sortedSnippets = allSnippets.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Get unique categories
const categories = [
  'All',
  'Astro',
  'Keystatic',
  'Jamstack',
  'UI',
  'Other'
] as const;

type Category = typeof categories[number];
---

<Layout title="Knowledge Base - Home">
  <!-- Decorative Background Glow -->
  <div class="absolute inset-x-0 top-0 -z-10 h-[500px] overflow-hidden pointer-events-none">
    <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-blue-500/20 to-transparent blur-3xl rounded-full opacity-50 dark:opacity-20"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 lg:py-24 relative">
    
    <!-- Hero Section -->
    <div class="mb-12 md:mb-20 text-center max-w-4xl mx-auto px-2">
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 mb-6 md:mb-8 drop-shadow-sm leading-tight">
        Development Knowledge Base
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium max-w-2xl mx-auto leading-relaxed">
        Internal tutorials, guides, and code snippets for rapid development
      </p>
    </div>

    <!-- Category Filter (Pill design) -->
    <div class="mb-12 md:mb-16 flex justify-center px-2">
      <div class="inline-flex flex-wrap justify-center gap-2 p-1.5 bg-white/60 dark:bg-gray-900/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-800/50">
        {categories.map((category) => (
          <button
            data-category={category}
            class="category-btn px-4 sm:px-6 py-2.5 rounded-xl text-sm sm:text-base font-medium transition-all duration-300 ease-out text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 active:scale-95"
          >
            {category}
          </button>
        ))}
      </div>
    </div>

    <!-- Featured Articles -->
    {sortedArticles.filter(article => article.data.featured).length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center gap-2">
          <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
          Featured Articles
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedArticles
            .filter(article => article.data.featured)
            .map((article) => (
              <article
                class="featured-card group relative bg-white/60 dark:bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-700/50 overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
                data-category={article.data.category}
              >
                <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                {article.data.coverImage?.src && (
                  <div class="w-full h-48 overflow-hidden rounded-t-2xl border-b border-gray-200/50 dark:border-gray-700/50">
                    <img 
                      src={article.data.coverImage.src} 
                      alt={article.data.coverImage.alt || article.data.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    />
                  </div>
                )}
                <div class="p-6 relative">
                  <div class="flex items-center gap-2 mb-4">
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-indigo-100/80 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 ring-1 ring-indigo-700/10 dark:ring-indigo-300/20">
                      {article.data.category}
                    </span>
                    <time class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                      {article.data.date.toLocaleDateString()}
                    </time>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
                    <a href={`/articles/${article.id}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors after:absolute after:inset-0">
                      {article.data.title}
                    </a>
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400 mb-5 line-clamp-2">
                    {article.data.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {article.data.tags.map((tag) => (
                      <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-700/80 text-gray-600 dark:text-gray-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
        </div>
      </section>
    )}

    <!-- All Articles -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">
        Articles & Guides
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedArticles
          .filter(article => !article.data.featured)
          .map((article) => (
            <article
              class="article-card group relative bg-white/60 dark:bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-700/50 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
              data-category={article.data.category}
            >
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              {article.data.coverImage?.src && (
                <div class="w-full h-40 overflow-hidden rounded-t-2xl border-b border-gray-200/50 dark:border-gray-700/50">
                  <img 
                    src={article.data.coverImage.src} 
                    alt={article.data.coverImage.alt || article.data.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  />
                </div>
              )}
              <div class="p-6 relative">
                <div class="flex items-center gap-2 mb-4">
                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-emerald-100/80 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-700/10 dark:ring-emerald-300/20">
                    {article.data.category}
                  </span>
                  <time class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                    {article.data.date.toLocaleDateString()}
                  </time>
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
                  <a href={`/articles/${article.id}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors after:absolute after:inset-0">
                    {article.data.title}
                  </a>
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mb-5 line-clamp-2">
                  {article.data.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {article.data.tags.map((tag) => (
                    <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-700/80 text-gray-600 dark:text-gray-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))}
      </div>
    </section>

    <!-- Code Snippets -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">
        Code Snippets
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedSnippets.map((snippet) => (
          <article
            class="snippet-card group relative bg-white/60 dark:bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-700/50 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
            data-category={snippet.data.category}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="p-6 relative">
              <div class="flex items-center gap-2 mb-4">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-fuchsia-100/80 dark:bg-fuchsia-900/50 text-fuchsia-700 dark:text-fuchsia-300 ring-1 ring-fuchsia-700/10 dark:ring-fuchsia-300/20">
                  {snippet.data.category}
                </span>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-amber-100/80 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 ring-1 ring-amber-700/10 dark:ring-amber-300/20">
                  {snippet.data.language}
                </span>
                <time class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                  {snippet.data.date.toLocaleDateString()}
                </time>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
                <a href={`/snippets/${snippet.id}/`} class="hover:text-fuchsia-600 dark:hover:text-fuchsia-400 transition-colors after:absolute after:inset-0">
                  {snippet.data.title}
                </a>
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-5 line-clamp-2">
                {snippet.data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {snippet.data.tags.map((tag) => (
                  <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-700/80 text-gray-600 dark:text-gray-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    const categoryButtons = document.querySelectorAll('.category-btn');
    const allCards = document.querySelectorAll('.featured-card, .article-card, .snippet-card');

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Update active state
        categoryButtons.forEach(btn => {
          btn.classList.remove('active', 'bg-white', 'dark:bg-gray-800', 'text-gray-900', 'dark:text-white', 'shadow-sm', 'ring-1', 'ring-gray-200', 'dark:ring-gray-700');
          btn.classList.add('text-gray-600', 'dark:text-gray-400');
        });
        
        button.classList.add('active', 'bg-white', 'dark:bg-gray-800', 'text-gray-900', 'dark:text-white', 'shadow-sm', 'ring-1', 'ring-gray-200', 'dark:ring-gray-700');
        button.classList.remove('text-gray-600', 'dark:text-gray-400');

        const category = button.dataset.category;

        // Filter cards
        allCards.forEach(card => {
          if (category === 'All' || card.dataset.category === category) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Set initial active state
    const allButton = document.querySelector('.category-btn[data-category="All"]');
    if (allButton) {
      allButton.classList.add('active', 'bg-white', 'dark:bg-gray-800', 'text-gray-900', 'dark:text-white', 'shadow-sm', 'ring-1', 'ring-gray-200', 'dark:ring-gray-700');
      allButton.classList.remove('text-gray-600', 'dark:text-gray-400');
    }
  </script>
</Layout>
