---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const articlesEn = await getCollection('articles_en');
const articlesRu = await getCollection('articles_ru');
const snippetsEn = await getCollection('snippets_en');
const snippetsRu = await getCollection('snippets_ru');

const allArticles = (lang === 'en' ? articlesEn : articlesRu).filter(
  (article: any) => !article.data.draft
);

const allSnippets = (lang === 'en' ? snippetsEn : snippetsRu).filter(
  (snippet: any) => !snippet.data.draft
);

// Sort by date (newest first)
const sortedArticles = allArticles.sort((a: any, b: any) => (a.data.order || 99) - (b.data.order || 99));

const sortedSnippets = allSnippets.sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);



---

<Layout title={t('nav.home')}>
  <!-- Decorative Background Glow -->
  <div class="absolute inset-x-0 top-0 -z-10 h-[500px] overflow-hidden pointer-events-none">
    <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-blue-500/20 to-transparent blur-3xl rounded-full opacity-50 dark:opacity-20"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 lg:py-24 relative">
    
    <!-- Hero Section -->
    <div class="mb-12 md:mb-20 text-center max-w-4xl mx-auto px-2">
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 mb-6 md:mb-8 drop-shadow-sm leading-tight">
        {t('hero.title')}
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium max-w-2xl mx-auto leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Horizontal Scrollable Articles -->
      <div class="mt-12 md:mt-16 text-left max-w-full relative group/carousel">
        <div class="flex items-center justify-between mb-4 px-2">
          <h3 class="text-lg md:text-xl font-semibold text-gray-800 dark:text-gray-200">
            {lang === 'en' ? 'Course Sections' : 'Разделы курса'}
          </h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pb-6 items-start">
          {sortedArticles.map((article: any, index: number) => {
            const heights = ['min-h-[280px]', 'min-h-[220px]', 'min-h-[320px]', 'min-h-[250px]', 'min-h-[290px]', 'min-h-[240px]'];
            const randomHeight = heights[index % heights.length];
            return (
              <a href={`/${lang}/articles/${article.id}/`.replace('//', '/').replace('/en/', '/')} class={`mb-6 w-full block group relative bg-white/60 dark:bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-700/50 overflow-hidden hover:-translate-y-1 hover:shadow-md transition-all duration-300 flex flex-col ${randomHeight}`}>
                {article.data.coverImage?.src && (
                  <div class="w-full h-40 overflow-hidden border-b border-gray-200/50 dark:border-gray-700/50 shrink-0">
                    <img 
                      src={article.data.coverImage.src} 
                      alt={article.data.coverImage.alt || article.data.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    />
                  </div>
                )}
                <div class="p-6 flex-grow flex flex-col justify-start">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 font-bold text-sm shrink-0">
                      {index + 1}
                    </div>
                    <h4 class="font-bold text-gray-900 dark:text-white line-clamp-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      {article.data.title}
                    </h4>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                    {article.data.description}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>





    <!-- Code Snippets -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">
        {t('section.snippets')}
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedSnippets.map((snippet) => (
          <article
            class="snippet-card group relative bg-white/60 dark:bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-sm border border-gray-200/50 dark:border-gray-700/50 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="p-6 relative">
              <div class="flex items-center gap-2 mb-4">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-amber-100/80 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 ring-1 ring-amber-700/10 dark:ring-amber-300/20">
                  {snippet.data.language}
                </span>
                <time class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                  {snippet.data.date.toLocaleDateString()}
                </time>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
                <a href={`/${lang}/snippets/${snippet.id}/`.replace('//', '/').replace('/en/', '/')} class="hover:text-fuchsia-600 dark:hover:text-fuchsia-400 transition-colors after:absolute after:inset-0">
                  {snippet.data.title}
                </a>
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-5 line-clamp-2">
                {snippet.data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {snippet.data.tags.map((tag: any) => (
                  <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-700/80 text-gray-600 dark:text-gray-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .masonry-grid {
    columns: 1;
    column-gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .masonry-grid {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .masonry-grid {
      columns: 3;
    }
  }
  .masonry-grid > * {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
</style>
