---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { type CollectionEntry } from 'astro:content';
import Alert from '../../../components/Alert.astro';
import YouTube from '../../../components/YouTube.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles_ru');
  return articles.map((article: any) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

type Props = {
  article: CollectionEntry<'articles_ru'>;
};

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Generate Table of Contents from headings
const toc = headings.map((heading) => ({
  level: heading.depth,
  text: heading.text,
  id: heading.slug,
}));
---

<Layout 
  title={article.data.title} 
  description={article.data.description}
  noindex={article.data.draft}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-8 lg:col-start-1">
        <article class="prose dark:prose-invert max-w-[65ch] mx-auto lg:mx-0">
          
          <!-- Article Header -->
          <header class="mb-10 pb-8 border-b border-gray-200/60 dark:border-gray-800/60">
            <div class="flex flex-wrap items-center gap-3 mb-6">

              <time class="text-sm font-medium text-gray-500 dark:text-gray-400">
                {article.data.date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
            </div>
            
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6 leading-[1.1]">
              {article.data.title}
            </h1>
            
            <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 leading-relaxed font-light mb-6">
              {article.data.description}
            </p>
            
            <div class="flex flex-wrap gap-2">
              {article.data.tags.map((tag) => (
                <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-800/80 text-gray-600 dark:text-gray-400 border border-gray-200/50 dark:border-gray-700/50">
                  #{tag}
                </span>
              ))}
            </div>
            
            {article.data.coverImage?.src && (
              <div class="mt-10 rounded-3xl overflow-hidden shadow-2xl border border-gray-200/50 dark:border-gray-700/50">
                <img 
                  src={article.data.coverImage.src} 
                  alt={article.data.coverImage.alt || article.data.title}
                  class="w-full h-auto max-h-[500px] object-cover"
                />
              </div>
            )}
          </header>

          <!-- Mobile TOC (visible only on small screens) -->
          {toc.length > 0 && (
            <details class="lg:hidden mb-10 group bg-gray-50 dark:bg-gray-900 rounded-2xl border border-gray-200/50 dark:border-gray-800/50 overflow-hidden">
              <summary class="flex items-center justify-between p-4 font-semibold cursor-pointer text-gray-900 dark:text-white list-none outline-none">
                In this article
                <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <nav class="px-4 pb-4 space-y-2 border-t border-gray-200/50 dark:border-gray-800/50 pt-4">
                {toc.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class={`block text-sm transition-colors ${
                      item.level === 2 
                        ? 'text-gray-800 dark:text-gray-200 font-medium' 
                        : 'text-gray-500 dark:text-gray-400 ml-4'
                    } hover:text-indigo-600 dark:hover:text-indigo-400`}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>
            </details>
          )}

          <!-- Article Content -->
          <div class="article-content">
            {article.data.hasVideo && article.data.videoUrl && (
              <YouTube videoId={article.data.videoUrl.split('/').pop() || article.data.videoUrl} />
            )}
            <Content components={{ Alert, YouTube }} />
          </div>
        </article>
      </div>

      <!-- Desktop Sidebar with TOC -->
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-28">
          <div class="bg-white/50 dark:bg-gray-900/50 backdrop-blur-md rounded-3xl border border-gray-200/50 dark:border-gray-800/50 p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.1)]">
            <h3 class="text-sm font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">
              In this article
            </h3>
            
            {toc.length > 0 ? (
              <nav class="space-y-3">
                {toc.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class={`block text-sm transition-all duration-200 ${
                      item.level === 2 
                        ? 'text-gray-700 dark:text-gray-300 font-medium hover:translate-x-1' 
                        : 'text-gray-500 dark:text-gray-500 ml-4 hover:text-gray-700 dark:hover:text-gray-300'
                    } hover:text-indigo-600 dark:hover:text-indigo-400`}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>
            ) : (
              <p class="text-sm text-gray-500 dark:text-gray-500">
                No headings found
              </p>
            )}
          </div>

          <div class="mt-6 flex items-center justify-center p-6 bg-gradient-to-br from-indigo-50/50 to-purple-50/50 dark:from-indigo-900/10 dark:to-purple-900/10 rounded-3xl border border-indigo-100 dark:border-indigo-900/30">
            <a href="/" class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
              Back to all articles
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    // Smooth scroll for TOC links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Add IDs to headings for TOC linking
    const headings = document.querySelectorAll('.article-content h2, .article-content h3, .article-content h4, .article-content h5, .article-content h6');
    headings.forEach(heading => {
      if(!heading.id) {
        const text = heading.textContent || '';
        const id = text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
        heading.id = id;
      }
    });
  </script>
</Layout>

<style is:global>
  /* Premium Typography & UX Styling */
  .article-content {
    @apply text-gray-800 dark:text-gray-300 text-lg md:text-[1.125rem] leading-[1.75];
  }
  
  .article-content h2 {
    @apply text-2xl md:text-3xl font-bold mt-12 mb-6 text-gray-900 dark:text-white tracking-tight;
  }
  
  .article-content h3 {
    @apply text-xl md:text-2xl font-semibold mt-10 mb-4 text-gray-900 dark:text-white tracking-tight;
  }
  
  .article-content p {
    @apply mb-6;
  }
  
  .article-content a {
    @apply text-indigo-600 dark:text-indigo-400 font-medium decoration-indigo-300/50 hover:decoration-indigo-500 underline underline-offset-4 transition-all;
  }
  
  .article-content code {
    @apply bg-gray-100 dark:bg-gray-800 text-indigo-600 dark:text-indigo-300 px-1.5 py-0.5 rounded-md text-[0.9em] font-mono border border-gray-200/50 dark:border-gray-700/50;
  }
  
  .article-content pre {
    @apply bg-[#0d1117] dark:bg-[#0d1117] rounded-2xl p-6 overflow-x-auto mb-8 shadow-xl border border-gray-800;
  }
  
  .article-content pre code {
    @apply bg-transparent p-0 text-gray-300 border-none font-mono text-sm leading-relaxed;
  }
  
  .article-content ul {
    @apply mb-6 ml-6 list-disc space-y-2 marker:text-indigo-400;
  }
  
  .article-content ol {
    @apply mb-6 ml-6 list-decimal space-y-2 marker:text-indigo-400 marker:font-semibold;
  }
  
  .article-content blockquote {
    @apply border-l-4 border-indigo-500 bg-indigo-50/50 dark:bg-indigo-900/10 rounded-r-2xl p-6 my-8 italic text-gray-700 dark:text-gray-300 text-xl font-serif;
  }
  
  .article-content img {
    @apply rounded-2xl shadow-lg my-10 w-full object-cover border border-gray-200/50 dark:border-gray-800/50;
  }
  
  .article-content table {
    @apply w-full border-collapse mb-8 text-sm md:text-base;
  }
  
  .article-content th, .article-content td {
    @apply border-b border-gray-200/60 dark:border-gray-800/60 px-4 py-4 text-left;
  }
  
  .article-content th {
    @apply bg-gray-50/50 dark:bg-gray-900/50 font-semibold text-gray-900 dark:text-white;
  }
</style>