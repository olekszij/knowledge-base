---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const snippets = await getCollection('snippets');
  return snippets.map((snippet) => ({
    params: { slug: snippet.id },
    props: { snippet },
  }));
}

type Props = {
  snippet: CollectionEntry<'snippets'>;
};

const { snippet } = Astro.props;
const { Content } = await render(snippet);
---

<Layout 
  title={snippet.data.title} 
  description={snippet.data.description}
  noindex={snippet.data.draft}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-8 lg:col-start-1">
        <article class="prose dark:prose-invert max-w-[65ch] mx-auto lg:mx-0">
          
          <!-- Snippet Header -->
          <header class="mb-10 pb-8 border-b border-gray-200/60 dark:border-gray-800/60">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-fuchsia-100/80 dark:bg-fuchsia-900/40 text-fuchsia-700 dark:text-fuchsia-300 ring-1 ring-fuchsia-700/10 dark:ring-fuchsia-300/20">
                {snippet.data.category}
              </span>
              <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-amber-100/80 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 ring-1 ring-amber-700/10 dark:ring-amber-300/20">
                {snippet.data.language}
              </span>
              <time class="text-sm font-medium text-gray-500 dark:text-gray-400">
                {snippet.data.date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
            </div>
            
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6 leading-[1.1]">
              {snippet.data.title}
            </h1>
            
            <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 leading-relaxed font-light mb-6">
              {snippet.data.description}
            </p>
            
            <div class="flex flex-wrap gap-2">
              {snippet.data.tags.map((tag) => (
                <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100/80 dark:bg-gray-800/80 text-gray-600 dark:text-gray-400 border border-gray-200/50 dark:border-gray-700/50">
                  #{tag}
                </span>
              ))}
            </div>
          </header>

          <!-- Snippet Content -->
          <div class="article-content">
            <Content />
          </div>
        </article>
      </div>

      <!-- Desktop Sidebar -->
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-28">
          <div class="bg-white/50 dark:bg-gray-900/50 backdrop-blur-md rounded-3xl border border-gray-200/50 dark:border-gray-800/50 p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.1)]">
            <h3 class="text-sm font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">
              Snippet Info
            </h3>
            
            <div class="space-y-4">
              <div>
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Language</span>
                <p class="text-base font-semibold text-gray-900 dark:text-white mt-1">
                  {snippet.data.language}
                </p>
              </div>
              
              <div>
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Category</span>
                <p class="text-base font-semibold text-gray-900 dark:text-white mt-1">
                  {snippet.data.category}
                </p>
              </div>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-center p-6 bg-gradient-to-br from-fuchsia-50/50 to-pink-50/50 dark:from-fuchsia-900/10 dark:to-pink-900/10 rounded-3xl border border-fuchsia-100 dark:border-fuchsia-900/30">
            <a href="/" class="text-sm font-semibold text-fuchsia-600 dark:text-fuchsia-400 hover:text-fuchsia-700 dark:hover:text-fuchsia-300 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
              Back to all snippets
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  /* Reuse same premium typography as articles */
  .article-content {
    @apply text-gray-800 dark:text-gray-300 text-lg md:text-[1.125rem] leading-[1.75];
  }
  
  .article-content h2 {
    @apply text-2xl md:text-3xl font-bold mt-12 mb-6 text-gray-900 dark:text-white tracking-tight;
  }
  
  .article-content h3 {
    @apply text-xl md:text-2xl font-semibold mt-10 mb-4 text-gray-900 dark:text-white tracking-tight;
  }
  
  .article-content p {
    @apply mb-6;
  }
  
  .article-content a {
    @apply text-fuchsia-600 dark:text-fuchsia-400 font-medium decoration-fuchsia-300/50 hover:decoration-fuchsia-500 underline underline-offset-4 transition-all;
  }
  
  .article-content code {
    @apply bg-gray-100 dark:bg-gray-800 text-fuchsia-600 dark:text-fuchsia-300 px-1.5 py-0.5 rounded-md text-[0.9em] font-mono border border-gray-200/50 dark:border-gray-700/50;
  }
  
  .article-content pre {
    @apply bg-[#0d1117] dark:bg-[#0d1117] rounded-2xl p-6 overflow-x-auto mb-8 shadow-xl border border-gray-800;
  }
  
  .article-content pre code {
    @apply bg-transparent p-0 text-gray-300 border-none font-mono text-sm leading-relaxed;
  }
  
  .article-content ul {
    @apply mb-6 ml-6 list-disc space-y-2 marker:text-fuchsia-400;
  }
  
  .article-content ol {
    @apply mb-6 ml-6 list-decimal space-y-2 marker:text-fuchsia-400 marker:font-semibold;
  }
  
  .article-content blockquote {
    @apply border-l-4 border-fuchsia-500 bg-fuchsia-50/50 dark:bg-fuchsia-900/10 rounded-r-2xl p-6 my-8 italic text-gray-700 dark:text-gray-300 text-xl font-serif;
  }
  
  .article-content img {
    @apply rounded-2xl shadow-lg my-10 w-full object-cover border border-gray-200/50 dark:border-gray-800/50;
  }
  
  .article-content table {
    @apply w-full border-collapse mb-8 text-sm md:text-base;
  }
  
  .article-content th, .article-content td {
    @apply border-b border-gray-200/60 dark:border-gray-800/60 px-4 py-4 text-left;
  }
  
  .article-content th {
    @apply bg-gray-50/50 dark:bg-gray-900/50 font-semibold text-gray-900 dark:text-white;
  }
</style>